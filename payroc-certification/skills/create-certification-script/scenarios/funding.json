      "expected": "201 with integer recipientId, status pending/approved, fundingAccountId(s).",
      "expectedStatus": 201,
      "endpoints": [
        {
          "method": "POST",
          "path": "/v1/funding-recipients",
          "tagField": "Idempotency-Key"
        }
      ],
      "testData": "KYC may be non-deterministic in UAT.",
      "evidence": [
        "recipientId",
        "fundingAccountId",
        "status"
      ],
      "pitfalls": "Exactly one control prong; isControlProng required on every owner; phone digits only."

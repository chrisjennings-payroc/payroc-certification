      "title": "Create funding recipient",
      "tier": "required",
      "kind": "happy",
      "platform": "payroc",
      "appliesWhen": [],
      "objective": "Verify recipient creation with KYC data and ids persisted.",
      "steps": [
        "POST /v1/funding-recipients with recipientType, taxId, doingBusinessAs, address, contactMethods, owners, fundingAccounts (use credit)."

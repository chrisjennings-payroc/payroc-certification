      "kind": "happy",
      "platform": "payroc",
      "appliesWhen": [],
      "objective": "Payroc verifies a single-use token is created (30 minute, one use).",
      "steps": [
        "POST /v1/processing-terminals/{processingTerminalId}/single-use-tokens with channel and source card.",
        "Capture token and expiresAt."
      ],
      "expected": "HTTP 201 with token and expiresAt; card number masked.",
      "expectedStatus": 201,
      "endpoints": [
        {
          "method": "POST",
          "path": "/v1/processing-terminals/{processingTerminalId}/single-use-tokens",
          "tagField": "Idempotency-Key"
        }
      ],
      "testData": "Use a Payroc UAT test card from docs.payroc.com (card number not documented in the source skills; confirm with Payroc)",
      "requestExample": {
        "channel": "web",
        "source": {
          "type": "card",
          "cardDetails": {
            "entryMethod": "keyed",
            "keyedData": {
              "dataFormat": "plainText",
              "cardNumber": "{{UAT_TEST_CARD}}",
              "cvv": "123",
              "expiryDate": "1230"
            },
            "cardholderName": "Sarah Hazel Hopper"
          }
        }
      },
      "evidence": [
        "token",
        "expiresAt",
        "HTTP status"
      ]
    },

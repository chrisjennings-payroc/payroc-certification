      "expected": "Endpoint returns 200 before processing; payload parsed per type.",
      "expectedStatus": 200,
      "endpoints": [],
      "testData": null,
      "evidence": [
        "delivery log with timestamp",
        "HTTP 200"
      ]
    },
    {
      "id": "EV-03",
      "title": "Payroc-Secret verification",
      "tier": "required",
      "kind": "negative",
      "platform": "payroc",
      "appliesWhen": [],
      "objective": "Verify the endpoint authenticates deliveries (Payroc-Secret header, constant-time).",
      "steps": [
        "Send a request with wrong Payroc-Secret."
      ],
      "expected": "Rejected with 401; correct secret accepted.",
      "expectedStatus": 401,
      "endpoints": [],
      "testData": null,
      "evidence": [
        "rejected request log"
      ],
      "pitfalls": "Payroc uses a shared-secret header, not documented HMAC."
    },
    {
      "id": "EV-04",
      "title": "Duplicate deliveries handled idempotently",
      "tier": "required",
      "kind": "edge",
      "platform": "payroc",
      "appliesWhen": [],
      "objective": "Verify CloudEvents id dedupe.",
      "steps": [
        "Deliver the same event id twice."
      ],
      "expected": "Processed once; second skipped.",
      "expectedStatus": 200,
      "endpoints": [],
      "testData": null,
      "evidence": [
        "event id",
        "dedupe log"
      ]
    },
    {
      "id": "EV-05",
      "title": "Failure and retry behaviour",
      "tier": "required",
      "kind": "edge",
      "platform": "payroc",
      "appliesWhen": [],
      "objective": "Verify partner copes with Payroc retries and fixes failures.",
      "steps": [
        "Return non-200 once, then 200 on retry; check subscription status."
      ],
      "expected": "Retried delivery accepted idempotently; failed subscription noticed via supportEmail/status.",
      "endpoints": [
        {
          "method": "GET",
          "path": "/v1/event-subscriptions/{subscriptionId}",
          "tagField": "id"
        }
      ],
      "testData": "Retry schedule beyond 'up to 5' not documented.",
      "evidence": [
        "event ids",
        "subscription status"
      ]

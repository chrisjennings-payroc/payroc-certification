  "openQuestions": [
    "EV-05: retry interval/backoff after 5 attempts not documented",
    "EV-03: no HMAC signature documented; only Payroc-Secret header",
    "RPT-*: UAT data seeding for settlement/disputes not documented"
  ],
  "scenarios": [
    {
      "id": "EV-01",
      "title": "Create event subscription",
      "tier": "required",
      "kind": "happy",
      "platform": "payroc",
      "appliesWhen": [],
      "objective": "Verify webhook registration.",
      "steps": [
        "POST event-subscriptions with enabled, eventTypes, notifications[{type webhook, uri, secret, supportEmailAddress}]; persist id."
      ],
      "expected": "201 with integer id, status registered; secret masked.",
      "expectedStatus": 201,
      "endpoints": [
        {
          "method": "POST",
          "path": "/v1/event-subscriptions",
          "tagField": "Idempotency-Key"
        }
      ],
      "testData": "Needs event-scoped UAT key.",
      "requestExample": {
        "enabled": true,
        "eventTypes": [
          "processingAccount.status.changed",
          "terminalOrder.status.changed"
        ],
        "notifications": [
          {
            "type": "webhook",
            "uri": "https://{{WEBHOOK_HOST}}/webhooks/payroc",
            "secret": "{{WEBHOOK_SECRET}}",
            "supportEmailAddress": "{{SUPPORT_EMAIL}}"
          }
        ]
      },
      "evidence": [
        "subscription id",
        "status"
      ]
    },
    {
      "id": "EV-02",
      "title": "Webhook acknowledges with 200 then processes async",
      "tier": "required",
      "kind": "happy",
      "platform": "payroc",
      "appliesWhen": [],
      "objective": "Verify prompt 200 and async handling.",
      "steps": [

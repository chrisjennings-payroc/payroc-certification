      "platform": "payroc",
      "appliesWhen": [],
      "objective": "Payroc verifies a single-use preset-charge link is created.",
      "steps": [
        "POST the payment-links endpoint with type singleUse, authType sale, flat charge object, expiresOn and merchantReference carrying the Test Tag.",

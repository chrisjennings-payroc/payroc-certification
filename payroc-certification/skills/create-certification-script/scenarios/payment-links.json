      ],
      "expected": "HTTP 201 with paymentLinkId and assets.paymentUrl.",
      "expectedStatus": 201,
      "endpoints": [
        {
          "method": "POST",
          "path": "/v1/processing-terminals/{processingTerminalId}/payment-links",
          "tagField": "merchantReference"
        }
      ],
      "testData": null,
      "requestExample": {
        "merchantReference": "{{TEST_TAG}}",
        "type": "singleUse",
        "authType": "sale",
        "paymentMethods": [
          "card"
        ],
        "expiresOn": "{{YYYY-MM-DD}}",
        "order": {
          "orderId": "{{ORDER_ID}}",
          "charge": {
            "type": "preset",
            "amount": 10000,
            "currency": "USD"
          }
        }
      },
      "evidence": [
        "paymentLinkId",
        "assets.paymentUrl",
        "HTTP status",
        "Idempotency-Key"
      ],
      "pitfalls": "charge is a flat object: type preset/prompt with amount/currency as siblings. Placement of charge inside the request is not shown precisely in the skill; confirm against the API schema."
